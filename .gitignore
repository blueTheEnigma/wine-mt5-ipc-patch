# Secrets: never commit
.env
.env.*
!.env.example
*login*.ini
*.pem
*.key
secrets/
config/credentials/*.env
!config/credentials/*.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
